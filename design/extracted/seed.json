  "doroWatSteps": [
    {
      "en": "Dice four red onions as fine as you can stand. No oil yet.",
      "am": "አራት ቀይ ሽንኩርት በተቻለ መጠን በጥሩ ይክተፉ። ገና ዘይት አይጨመርም።"
    },
    {
      "en": "Dry-cook them in a bare pan until they collapse and darken.",
      "am": "በባዶ ድስት እስኪለሰልሱና እስኪጠቁሩ ድረስ በደረቁ ያብስሏቸው።"
    },
    {
      "en": "Add the niter kibbeh. Let it melt all the way through.",
      "am": "ንጥር ቅቤውን ይጨምሩ። ሙሉ በሙሉ እንዲቀልጥ ያድርጉ።"
    },
    {
      "en": "Stir in the berbere and cook it out — eight minutes, low.",
      "am": "በርበሬውን ይጨምሩና ያብስሉት — ስምንት ደቂቃ፣ በዝቅተኛ እሳት።"
    },
    {
      "en": "Add garlic and ginger paste. It should smell sharp, not raw.",
      "am": "ነጭ ሽንኩርትና ዝንጅብል ይጨምሩ። ሽታው ጥሬ ሳይሆን ጥርት ያለ ይሁን።"
    },
    {
      "en": "Add the chicken and turn every piece until it is coated.",
      "am": "ዶሮውን ይጨምሩና እያንዳንዱ ቁራጭ እስኪለበስ ድረስ ይገልብጡ።"
    },
    {
      "en": "Simmer 45 minutes. Add water only if the pan catches.",
      "am": "ለ45 ደቂቃ ያንተከትኩ። ውሃ የሚጨመረው ድስቱ ሲይዝ ብቻ ነው።"
    },
    {
      "en": "Score the boiled eggs and slide them in whole.",
      "am": "የተቀቀሉትን እንቁላሎች ተልትለው ሙሉውን ይጨምሩ።"
    },
    {
      "en": "Rest ten minutes. Serve on injera with ayib.",
      "am": "ለአሥር ደቂቃ ያሳርፉ። ከአይብ ጋር በእንጀራ ያቅርቡ።"
    }
  ],
