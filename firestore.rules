rules_version = '2';

// FlameUp security rules.
//
// The central invariant: progression is server-authoritative. XP, level,
// streak, mastery, achievements and rating aggregates are written only by
// Cloud Functions, which run with admin credentials and bypass these rules.
// A client that tries is refused -- which is what makes the reward function
// the only path to XP rather than merely the intended one.
//
// `allow read, write: if true;` appears nowhere.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- helpers ---------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    /// Fields only the server may set or change.
    function serverOnlyUserFields() {
      return [
        'xp', 'level', 'flames', 'longestStreak', 'lastCookedOn',
        'freezeDaysLeft', 'recipesCooked', 'recipesMastered', 'regionsTasted'
      ];
    }

    /// True when the write leaves every server-only field exactly as it was.
    ///
    /// diff().affectedKeys() is the mechanism: a client may edit its display
    /// name in the same document that holds its XP, but it cannot touch the
    /// XP while doing so.
    ///
    /// hasAny() takes a **list**, not a set. Passing a set is an unsupported
    /// operation that makes the whole rule error -- and an erroring rule
    /// denies, so this once silently blocked legitimate profile creation as
    /// well as the writes it was meant to stop. Caught by the emulator tests
    /// in rules-tests/, which is the only place it could have been caught.
    function leavesProgressionAlone() {
      return !incoming().diff(existing()).affectedKeys()
        .hasAny(serverOnlyUserFields());
    }

    /// A create must not arrive with progression already filled in.
    function createsWithoutProgression() {
      return !incoming().keys().hasAny(serverOnlyUserFields());
    }

    function isModerator() {
      // The claim is usually absent, and reading a missing token key is an
      // error rather than a false — which would deny paths that merely ask
      // "is this a moderator?" as their last resort. Guard the read.
      return signedIn()
        && ('moderator' in request.auth.token)
        && request.auth.token.moderator == true;
    }

    function isAnonymous() {
      // Production Auth tokens always carry sign_in_provider; hand-minted
      // test tokens may not. Reading a missing key errors rather than
      // returning false, so guard it — an absent provider is treated as a
      // permanent account, which is what tests (and any future custom-token
      // path) intend.
      return signedIn()
        && ('sign_in_provider' in request.auth.token)
        && request.auth.token.sign_in_provider == 'anonymous';
    }

    /// Community contributions require a permanent account.
    ///
    /// Anonymous accounts are free, unlimited and minted per device, so a
    /// guest with write access to the archive is a spammer with an infinite
    /// supply of identities. Guests can read and cook; publishing, vouching
    /// and rating are for people who signed up.
    function permanentUser() {
      return signedIn() && !isAnonymous();
    }

    /// The display name pinned to the writer's public directory card.
    ///
    /// Social labels ("X vouched for your recipe") must come from the one
    /// place the writer cannot diverge from: their own directory card, whose
    /// `uid` field the rules bind to the signer. Reading it here means a
    /// forged name cannot ride in on an otherwise valid write. A card is
    /// optional, so an absent one falls back to the anonymous-but-honest
    /// generic label.
    function pinnedProfileName() {
      let card = /databases/$(database)/documents/user_directory/$(request.auth.uid);
      // Map.get(key, default) covers both a missing card and a malformed
      // one without erroring; the card's own create rules guarantee the
      // name is a bounded string when it exists.
      return exists(card)
        ? get(card).data.get('displayName', '')
        : '';
    }

    // --- users -----------------------------------------------------------

    match /users/{uid} {
      // A profile is readable by its owner. Public visibility is resolved by
      // the fields the client is allowed to denormalise elsewhere, not by
      // opening the whole document.
      allow get: if isOwner(uid) ||
        (signedIn() && existing().profileVisibility == 'public');
      allow list: if false;

      allow create: if isOwner(uid) && createsWithoutProgression();
      allow update: if isOwner(uid) && leavesProgressionAlone();
      allow delete: if isOwner(uid);

      // Cooking sessions are private and client-written: they are a record of
      // what happened, not of what it was worth. A COMPLETED session is
      // frozen — every downstream check (reviews, weekly entries, versions'
      // proof-of-cook) treats "completed" as having happened, so a client
      // that could resurrect or rewrite one could launder a fake cook after
      // the fact. In-progress sessions stay freely writable: advancing steps,
      // pausing timers and finishing are all normal edits of the same doc.
      // The outbox drops exhausted mutations rather than looping, so a
      // queued step write landing after completion fails once and is
      // discarded — the local record keeps the truth.
      match /cooking_sessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && incoming().status in ['in_progress', 'completed'];
        allow update: if isOwner(uid)
          && (existing().status != 'completed'
            || incoming().status == existing().status);
        allow delete: if isOwner(uid);
      }

      // Everything the server grants is read-only to the client.
      match /mastery/{recipeId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /user_achievements/{achievementId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /reward_claims/{key} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Quest progress is server-written, because it converts into XP.
      match /user_quests/{questId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // Personal lists carry no reward, so the owner may write them freely.
      match /saved_recipes/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      match /shopping_items/{itemId} {
        allow read, write: if isOwner(uid);
      }

      match /meal_plans/{weekId} {
        allow read, write: if isOwner(uid);
      }

      // Notifications are server-written — EXCEPT the vouch notification,
      // which by definition must come from the peer who just vouched. The
      // rules make that one shape safe:
      //   · id is 'vouch_' + recipeId + '_' + vouchingUid — deterministic, so
      //     a replayed or double-tapped write lands on the same document
      //     instead of spamming copies (overwrites can only rewind the
      //     count, never forge a new kind of message). The rules verify the
      //     id by CONCATENATION against the payload's recipeId — never by
      //     splitting, which breaks on ids that contain underscores (most
      //     catalogue ids do: doro_wat, kitfo_gursha, …).
      //   · the type is fixed, every string is bounded, the count matches
      //     the array cap verification enforces (50);
      //   · the claimed vouch must actually exist: the cited recipe's
      //     verifiedBy must contain the signer. No session, no notification.
      //   · the recipe must not be the author's own (rules elsewhere block
      //     author vouches; this keeps a forged notice from implying one).
      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid);
        // The inbox is the owner's to prune: notifications are small but
        // unbounded in number, and only the person they belong to can say
        // which are noise. Deletes touch nobody else's data.
        allow delete: if isOwner(uid);

        // The writer is the VOUCHING COOK, not the owner — vouchIsReal
        // pins the writer, the recipient (the recipe's author), and the
        // real vouch the note cites. The shape is exhaustive: no extra
        // field can ride along. The writer must hold a permanent account
        // (see permanentUser) and the name on the note is PINNED to their
        // directory card — a vouch note is a signature, not a free-text
        // field, so an impersonated "Abeni T." cannot ride in on a real
        // vouch. When the writer has no card the payload must carry the
        // same empty generic label.
        allow create: if permanentUser()
          && request.resource.data.keys().hasOnly(
            ['type', 'recipeId', 'otherUid', 'otherName', 'count',
             'createdAt', 'readAt'])
          && request.resource.data.type in ['recipeVouched', 'recipeVerified']
          // The verified celebration only fires on the threshold vouch.
          && (request.resource.data.type == 'recipeVouched'
            || request.resource.data.count == 3)
          && request.resource.data.recipeId is string
          && request.resource.data.recipeId.size() > 0
          && request.resource.data.recipeId.size() <= 120
          // Deterministic id, rebuilt from the payload — no parsing.
          && notificationId == 'vouch_' + request.resource.data.recipeId
            + '_' + request.auth.uid
          && request.resource.data.otherUid is string
          && request.resource.data.otherUid.size() > 0
          && request.resource.data.otherUid.size() <= 60
          && request.resource.data.otherName
            == pinnedProfileName()
          && request.resource.data.count is int
          && request.resource.data.count >= 1
          && request.resource.data.count <= 50
          && vouchIsReal();
      }

      // Is the claimed vouch real? Read the recipe the payload names —
      // with getAfter, because the app writes the vouch and the note in ONE
      // transaction: get() would see the pre-batch recipe (vouch not yet
      // appended, count one short) and deny the very notification the
      // honest flow produces. getAfter evaluates against post-batch state;
      // standalone writes behave the same either way.
      function vouchIsReal() {
        let recipe = getAfter(
          /databases/$(database)/documents/family_recipes/$(request.resource.data.recipeId)).data;
        return request.auth.uid in recipe.verifiedBy
          && recipe.verifiedBy.size() == request.resource.data.count
          && recipe.authorId == uid
          && request.auth.uid != uid;
      }

      // A friendship belongs to both people: accepting a request or removing
      // a friend writes the mirror document into the other side's collection,
      // so either party may write a document keyed by themselves. Reading
      // stays owner-only.
      match /friends/{otherUid} {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) || isOwner(otherUid);
      }

      match /friend_requests/{otherUid} {
        allow read: if isOwner(uid);
        // Either party may write: the sender creates the outgoing request and
        // the recipient answers it.
        allow write: if isOwner(uid) || isOwner(otherUid);
      }

      match /outbox/{key} {
        allow read, write: if isOwner(uid);
      }
    }

    // --- user directory ----------------------------------------------------

    // Public, minimal search cards. A profile document forbids list queries,
    // so the fields finding a person needs live here, opt-in per user, with
    // nothing but name, search key and friend code exposed. The card is
    // writable only by its own user; the friend code is public by design
    // (it is handed out to be typed), so it is validated for shape only.
    match /user_directory/{uid} {
      allow read: if signedIn();
      allow create: if isOwner(uid)
        && permanentUser()
        && incoming().keys().hasOnly(['uid', 'displayName', 'nameSearch', 'friendCode'])
        && incoming().uid == uid
        && incoming().displayName is string
        && incoming().displayName.size() > 0
        && incoming().displayName.size() <= 60
        && incoming().nameSearch is string
        && incoming().nameSearch.size() > 0
        && incoming().nameSearch.size() <= 60
        && incoming().friendCode is string
        && incoming().friendCode.size() == 8;
      allow update: if isOwner(uid)
        && permanentUser()
        && incoming().uid == uid;
      allow delete: if isOwner(uid);
    }

    // --- recipes ---------------------------------------------------------

    match /recipes/{recipeId} {
      allow read: if true;
      // Curated recipes are seeded and maintained server-side. Family recipes
      // reach this collection only when moderation publishes them.
      allow write: if isModerator();

      match /reviews/{uid} {
        allow read: if true;

        // A review must be your own, and must reference a completed cooking
        // session that you own. This is where "you can only rate what you
        // actually cooked" is enforced -- the client cannot fake it, because
        // the session document is checked here.
        allow create, update: if permanentUser()
          && isOwner(uid)
          && incoming().uid == uid
          && incoming().sessionId is string
          && exists(/databases/$(database)/documents/users/$(uid)/cooking_sessions/$(incoming().sessionId))
          && get(/databases/$(database)/documents/users/$(uid)/cooking_sessions/$(incoming().sessionId)).data.status == 'completed';

        allow delete: if isOwner(uid) || isModerator();
      }
    }

    match /regions/{regionId} {
      allow read: if true;
      allow write: if isModerator();
    }

    // --- family recipes --------------------------------------------------

    match /family_recipes/{id} {
      // A draft is private to its author. A PENDING submission is in
      // community review: any signed-in user may read it, because vouching
      // for a recipe you cannot see is not verification, it is a stamp.
      allow read: if existing().status == 'published'
        || existing().status == 'pending'
        || isOwner(existing().authorId)
        || isModerator();

      allow create: if permanentUser()
        && incoming().authorId == request.auth.uid
        && incoming().status in ['draft', 'pending']
        // Variants: a submission may declare the recipe it is a version of,
        // and the label that says what is different. An original leaves both
        // unset. The base must exist — and a variant of a catalogue dish
        // additionally requires proof the submitter has actually cooked that
        // dish here: a completed session in their OWN history, for exactly
        // that recipe. Claiming to improve a classic you never made is what
        // this blocks.
        && variantFieldsAreValid()
        && variantBaseIsValid();

      // Three update paths, spelled out so none can masquerade as another:
      //
      // 1. The author edits their own still-unpublished work. They may set
      //    everything EXCEPT verification — vouches are other people's
      //    votes, and content edits cannot touch content review.
      // 2. Community verification: anyone EXCEPT the author appends their
      //    own uid to verifiedBy. The rules prove the append — the array
      //    only grows, each vouch appears once, nothing else changes — and
      //    at three vouches the recipe publishes itself. Moderation by
      //    community, with no server in between.
      // 3. The moderator path stays for takedowns and fixes; community
      //    verification is ADDITIVE to moderation, not a replacement.
      allow update: if authorContentEdit()
        || communityVerification()
        || isModerator();

      allow delete: if isOwner(existing().authorId) || isModerator();

      // Generations name the people a recipe was passed down through, so
      // they inherit the parent's visibility rather than being public. A
      // world-readable subcollection under a private draft would leak family
      // names the author has not published.
      match /generations/{generationId} {
        function parent() {
          return get(/databases/$(database)/documents/family_recipes/$(id)).data;
        }
        allow read: if parent().status == 'published'
          || parent().status == 'pending'
          || isOwner(parent().authorId)
          || isModerator();
        allow write: if isOwner(parent().authorId) || isModerator();
      }

      // --- variant shape ---------------------------------------------------

      function variantFieldsAreValid() {
        // Either both fields or neither; when present, a real id to link to
        // and a label someone could read out loud.
        return (!('baseId' in request.resource.data)
            && !('variantLabel' in request.resource.data))
          || (('baseId' in request.resource.data)
            && ('variantLabel' in request.resource.data)
            && request.resource.data.baseId is string
            && request.resource.data.baseId.size() > 0
            && request.resource.data.baseId.size() <= 100
            && request.resource.data.baseId != id
            && request.resource.data.variantLabel is string
            && request.resource.data.variantLabel.size() > 0
            && request.resource.data.variantLabel.size() <= 200);
      }

      // Family-recipe ids are uuids; catalogue ids are slugs. The shape of
      // the id is what tells the two worlds apart.
      function isUuid(value) {
        return value.matches('^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$');
      }

      function variantBaseIsValid() {
        return !('baseId' in request.resource.data)
          // A family base: must exist in the archive. exists() reads the
          // database directly, so a stranger's still-pending recipe is
          // still checkable.
          || (isUuid(request.resource.data.baseId)
            && exists(/databases/$(database)/documents/family_recipes/$(request.resource.data.baseId)))
          // A catalogue base: must exist, and the submitter must cite one of
          // their own completed cooking sessions for exactly that dish —
          // the proof-of-cook gate. The session path pins uid to the signer,
          // so nobody can cite a friend's history.
          || ('proofSessionId' in request.resource.data
            && request.resource.data.proofSessionId is string
            && request.resource.data.proofSessionId.size() > 0
            && request.resource.data.proofSessionId.size() <= 100
            && exists(/databases/$(database)/documents/recipes/$(request.resource.data.baseId))
            && cookedProof());
      }

      function cookedProof() {
        let session = get(/databases/$(database)/documents/users/$(request.auth.uid)/cooking_sessions/$(request.resource.data.proofSessionId)).data;
        return session.status == 'completed'
          && session.recipeId == request.resource.data.baseId;
      }

      // --- verification ----------------------------------------------------

      // Path 1: the author's content edit. Author, still private, and the
      // write touches everything but the vouches — the one field that is
      // other people's to change.
      function authorContentEdit() {
        return isOwner(existing().authorId)
          && existing().status in ['draft', 'pending']
          && incoming().status in ['draft', 'pending']
          && !incoming().diff(existing()).affectedKeys()
            .hasAny(['verifiedBy']);
      }

      // Path 2: a community vouch. ONLY verifiedBy may change (plus the
      // auto-publish status flip this same write may cause), the array may
      // gain exactly one element — the signer's own uid, once — and the
      // author can never vouch for their own work. The threshold lives here
      // so no client can fake it.
      function communityVerification() {
        // A recipe may predate the verification feature: absent counts as
        // an empty list on both sides of the diff.
        let before = ('verifiedBy' in existing())
          ? existing().verifiedBy : [];
        let after = ('verifiedBy' in request.resource.data)
          ? request.resource.data.verifiedBy : [];
        return signedIn()
          && request.auth.uid != existing().authorId
          && existing().status in ['pending', 'published']
          && incoming().diff(existing()).affectedKeys()
            .hasOnly(['verifiedBy', 'status'])
          && before is list
          && after is list
          // Exactly one new element, everything already there preserved.
          && after.size() == before.size() + 1
          && after.hasAll(before)
          // The one new element is the signer: absent before, present after,
          // with the size bound above — that can only be the appended one.
          && !(request.auth.uid in before)
          && request.auth.uid in after
          // No runaway arrays.
          && after.size() <= 50
          // Publish at three vouches, only out of pending; a published
          // recipe keeps collecting vouches but stays published.
          && incoming().status == (after.size() >= 3
              && existing().status == 'pending'
                ? 'published'
                : existing().status);
      }
    }

    // --- community -------------------------------------------------------

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && incoming().authorId == request.auth.uid;
      // Counters are maintained by triggers, so an author editing their own
      // post cannot inflate its like count.
      allow update: if isOwner(existing().authorId)
        && !incoming().diff(existing()).affectedKeys()
          .hasAny(['likeCount', 'commentCount']);
      allow delete: if isOwner(existing().authorId) || isModerator();

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && incoming().authorId == request.auth.uid;
        allow update, delete: if isOwner(existing().authorId) || isModerator();
      }

      // Keyed by uid, so a double tap cannot double-count.
      match /likes/{uid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }
    }

    // --- challenges ------------------------------------------------------

    match /challenges/{challengeId} {
      allow read: if signedIn()
        && request.auth.uid in [existing().createdBy, existing().opponentId];
      allow create: if signedIn() && incoming().createdBy == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid in [existing().createdBy, existing().opponentId]
        // The winner is decided server-side.
        && !incoming().diff(existing()).affectedKeys().hasAny(['winnerId']);
      allow delete: if false;

      match /submissions/{uid} {
        // A participant cannot read the other's submission until both exist,
        // which is what keeps the comparison honest.
        allow read: if isOwner(uid)
          || (signedIn()
            && exists(/databases/$(database)/documents/challenges/$(challengeId)/submissions/$(request.auth.uid)));
        allow create: if isOwner(uid);
        allow update, delete: if false;
      }
    }

    // --- weekly competition ----------------------------------------------

    // The week's cook-off. Written only by a moderator (or the seeder's
    // admin-plane writes, which bypass rules); read by everyone signed in.
    match /weekly_challenges/{weekId} {
      allow read: if signedIn();
      allow write: if isModerator();

      match /entries/{uid} {
        allow read: if signedIn();

        // An entry is a claim the backend can check, so it checks it:
        // before the entry lands, the week must exist and be open, and the
        // cited session must exist in the entrant's own cooking_sessions,
        // be completed, and be for the dish the week is about. The recipe
        // doc supplies the only XP figure an entry may carry. A fudged
        // device clock enters nothing: the deadline is compared against the
        // server's request.time.
        allow create: if permanentUser()
          && isOwner(uid)
          && weeklyEntryIsValid(weekId);
        // Entries are immutable once written: no edits, no withdrawals,
        // no re-entries under a different session.
        allow update, delete: if false;
      }
    }

    // The weekly XP rows behind the leaderboard. This is the one deliberate
    // compromise of the Spark (no-Cloud-Functions) tier: rows are written by
    // the client on cook completion rather than by a trusted function. The
    // rules bound the damage a client can do — own row only, never lower,
    // bounded size — while the honest path (the app's own writer) reports
    // exactly what the recipe's xpReward grants.
    match /weekly_xp/{rowId} {
      allow read: if signedIn();

      // rowId is '{weekId}_{uid}': the key itself ties the row to its owner
      // and its week, and a retried write merges instead of duplicating.
      // Only the current week may be written — a device cannot claim last
      // week — and weekId parity with the client is proven by the rules
      // tests, which write a row through both implementations.
      allow create: if permanentUser()
        && isOwner(rowId.split('_')[1])
        && validWeeklyRowShape(rowId);

      allow update: if permanentUser()
        && isOwner(rowId.split('_')[1])
        && validWeeklyRowShape(rowId)
        && incoming().xp >= existing().xp
        && incoming().cooks > existing().cooks;

      allow delete: if false;
    }

    // Shape and honesty of a row write, shared by create and update.
    function validWeeklyRowShape(rowId) {
      return incoming().uid == request.auth.uid
        && incoming().weekId == currentWeekId()
        && incoming().xp is int
        && incoming().cooks is int
        && incoming().xp >= 0 && incoming().xp <= 10000
        && incoming().cooks >= 0 && incoming().cooks <= 100
        && incoming().displayName is string
        && incoming().displayName.size() > 0
        && incoming().displayName.size() <= 60
        && rowId == incoming().weekId + '_' + request.auth.uid;
    }

    // ISO week id ('w2026w38') for the week containing request.time —
    // the server's clock, not the device's. Must stay in lockstep with
    // weekIdFor() in lib/features/community/domain/weekly_competition.dart.
    function currentWeekId() {
      let dayMs = 86400000;
      let epochDays = request.time.toMillis() / dayMs;
      // Epoch day 0 is a Thursday: Monday of the week is 3 days back,
      // so snap to Monday with ((d + 3) / 7) * 7 - 3 and take the week's
      // Thursday (Monday + 3) — the ISO year is that Thursday's year.
      let monday = ((epochDays + 3) / 7) * 7 - 3;
      let thursday = monday + 3;
      let isoYear = civilYearOf(thursday);
      let week = ((thursday - mondayOfIsoWeekOne(isoYear)) / 7) + 1;
      return 'w' + string(isoYear) + 'w' + string(week);
    }

    // The Gregorian year containing the given epoch day
    // (Howard Hinnant's civil_from_days).
    function civilYearOf(epochDays) {
      let z = epochDays + 719468;
      let era = z / 146097;
      let doe = z - era * 146097;
      let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
      return yoe + era * 400;
    }

    // Monday of ISO week 1 of [isoYear]: the Monday of the week containing
    // 4 January, whose week always holds the first Thursday.
    function mondayOfIsoWeekOne(isoYear) {
      let jan4 = daysFromCivil(isoYear, 1, 4);
      return jan4 - ((jan4 + 3) % 7);
    }

    // Days since 1970-01-01 for a civil date (Hinnant's days_from_civil).
    function daysFromCivil(y, m, d) {
      let yy = m <= 2 ? y - 1 : y;
      let era = yy / 400;
      let yoe = yy - era * 400;
      let mp = (m + (m > 2 ? -3 : 9));
      let doy = (153 * mp + 2) / 5 + d - 1;
      let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;
      return era * 146097 + doe - 719468;
    }

    // Validity of a cook-off entry: week open, session real, recipe matching.
    // A get() on a missing document errors, which denies — the intended
    // outcome for a made-up session id.
    function weeklyEntryIsValid(weekId) {
      let week = get(/databases/$(database)/documents/weekly_challenges/$(weekId)).data;
      let session = get(/databases/$(database)/documents/users/$(request.auth.uid)/cooking_sessions/$(incoming().sessionId)).data;
      let recipe = get(/databases/$(database)/documents/recipes/$(week.recipeId)).data;
      return request.time < week.deadline
        && incoming().uid == request.auth.uid
        && incoming().sessionId is string
        && incoming().sessionId.size() > 0
        && incoming().displayName is string
        && incoming().displayName.size() > 0
        && incoming().displayName.size() <= 60
        && incoming().xp is int
        && incoming().xp >= 0 && incoming().xp <= 1000
        // photoUrl is optional: absent is fine, present must be a string.
        && (!('photoUrl' in incoming().keys()) || incoming().photoUrl is string)
        && session.status == 'completed'
        && session.recipeId == week.recipeId
        && incoming().xp == recipe.xpReward;
    }

    // --- leaderboards, config, reports -----------------------------------

    match /leaderboards/{scope} {
      allow read: if signedIn();
      // Aggregated by a scheduled function.
      allow write: if false;
    }

    match /config/{document} {
      allow read: if true;
      allow write: if isModerator();
    }

    match /reports/{reportId} {
      // Write-only for clients: a reporter cannot read the moderation queue.
      allow create: if signedIn() && incoming().reporterId == request.auth.uid;
      allow read, update, delete: if isModerator();
    }
  }
}
