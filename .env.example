# FlameUp -- environment template. Copy to .env and fill in.
# .env is git-ignored. Nothing in this file is read by the Flutter app at
# runtime: the client gets its Firebase identifiers from lib/firebase_options.dart,
# and every real secret lives server-side in Cloud Functions config.

# --- Flutter build flags ---------------------------------------------------
# Point the app at the local emulator suite instead of the live project.
#   flutter run --dart-define=USE_FIREBASE_EMULATOR=true
USE_FIREBASE_EMULATOR=false
# Host the emulators are reachable on. Use 10.0.2.2 from the Android emulator.
FIREBASE_EMULATOR_HOST=localhost

# --- Cloud Functions (set with `firebase functions:config:set`, never here) --
# The AI cooking assistant proxies through a Cloud Function so no provider key
# is ever shipped inside the app binary. See docs/ARCHITECTURE.md.
# ANTHROPIC_API_KEY=
# AI_MODEL=

# --- Android release signing (Phase 15) ------------------------------------
# Written to android/key.properties, which is git-ignored.
# ANDROID_KEYSTORE_PATH=
# ANDROID_KEYSTORE_PASSWORD=
# ANDROID_KEY_ALIAS=
# ANDROID_KEY_PASSWORD=
