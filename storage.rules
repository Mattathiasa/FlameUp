rules_version = '2';

// FlameUp Storage rules.
//
// Uploads are scoped to their owner and capped in size and type, so a
// compromised or careless client cannot fill the bucket or serve something
// that is not an image. Content types are allowlisted rather than merely
// prefixed: a client-declared "video/x" of arbitrary bytes is storage abuse,
// so the extensions and MIME types must both match what the app actually
// sends (see FamilyRecipeRepository.uploadMedia for the canonical list).

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }

    // Family recipes carry photos of dishes and video of the cooking
    // itself -- the archive's whole point. The MIME prefixes are checked,
    // but a prefix alone would admit "image/anything"; the extension in the
    // file name must agree with the declared type, so junk renamed .mp4 is
    // rejected at the extension, and a fake MIME on a .jpg name is rejected
    // at the type.
    function isMedia(name) {
      return extensionMatchesType(name.lower(),
        request.resource.contentType);
    }

    function extensionMatchesType(name, contentType) {
      return contentType == 'image/jpeg' && name.matches('.*\\.jpe?g')
        || contentType == 'image/png' && name.matches('.*\\.png')
        || contentType == 'image/webp' && name.matches('.*\\.webp')
        || contentType == 'image/gif' && name.matches('.*\\.gif')
        || contentType == 'image/heic' && name.matches('.*\\.heic')
        || contentType == 'video/mp4' && name.matches('.*\\.mp4')
        || contentType == 'video/quicktime' && name.matches('.*\\.mov')
        || contentType == 'video/x-m4v' && name.matches('.*\\.m4v');
    }

    function underSizeLimit(megabytes) {
      return request.resource.size < megabytes * 1024 * 1024;
    }

    // Profile photos are public, since they appear beside posts and on
    // leaderboards.
    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if isOwner(uid) && isImage() && underSizeLimit(5);
      allow delete: if isOwner(uid);
    }

    // Photos of a finished dish, attached to a review or a post.
    match /users/{uid}/cooking/{sessionId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isImage() && underSizeLimit(10);
      allow delete: if isOwner(uid);
    }

    // Family recipe media, kept inside the author's own space so ownership
    // is checkable from the path alone. Video is capped well below the old
    // 100 MB: enough for a few minutes of a phone recording, not enough to
    // make the bucket a free file host.
    //
    // Read is any signed-in user, which means media attached to a *draft*
    // is technically visible before its recipe is published. The sensitive
    // content -- names, stories, steps -- lives in Firestore and stays
    // private there; the trade is documented rather than papered over with a
    // cross-service lookup that would break offline-first uploads.
    match /users/{uid}/family_recipes/{recipeId}/{fileName} {
      allow read: if signedIn();
      allow write: if isOwner(uid) && isMedia(fileName) && underSizeLimit(30);
      allow delete: if isOwner(uid);
    }

    // Curated recipe photography is uploaded out of band, never by the app.
    match /recipes/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
