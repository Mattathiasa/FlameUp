# FlameUp — local emulator profile for the ANDROID emulator.
# The Android emulator cannot see the host's 127.0.0.1; 10.0.2.2 is the
# special alias for the host machine. Start the backend first:
#   cd /Users/mattathiasa/Projects/FlameUp && firebase emulators:start
# Then run:
#   ../run_flutter_app.sh flameup:emulator-android run

USE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=10.0.2.2
