# FlameUp — production profile TEMPLATE.
# Copy to production.env, fill in, and DO NOT commit production.env.
#   cp config/production.env.example config/production.env
#
# The live Firebase identifiers are already compiled into
# lib/firebase_options.dart, so production usually needs NO profile at all —
# a bare `flutter run` targets flameup-78d15. Only use this file if you want
# to override emulator flags explicitly or swap projects.
# Then run:
#   ../run_flutter_app.sh flameup:production run

USE_FIREBASE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost

# Photo hosting (free tier). Create the unsigned preset first - see .env.example.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
