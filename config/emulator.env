# FlameUp — local emulator profile (iOS simulator / desktop / web).
# Every key here is compiled into the app by --dart-define-from-file.
# Start the backend first:
#   cd /Users/mattathiasa/Projects/FlameUp && firebase emulators:start
# Then run:
#   ../run_flutter_app.sh flameup:emulator run

USE_FIREBASE_EMULATOR=true
FIREBASE_EMULATOR_HOST=localhost
